# ------------------ Hyperparameters ------------------

# Training setup
RUN_NAME="SDM_eval_small"
MODEL_TYPE="ebm"
MODEL_SIZE="small"
SEED=0
PATCH_SIZE=1

EPOCHS=1
WARMUP_EPOCHS=0
BATCH_SIZE_PER_DEVICE=64
LR=0.0001
GRAD_ACCU=1
WEIGHT_DECAY=0.02

# Diffusion
DIFFUSION_TIMESTEPS=1000
NUM_SAMPLING_STEPS=250
BETA_SCHEDULE="cosine"

# Energy-Based Model (MCMC)
MCMC_STEP_SIZE=0.0001
ENERGY_GRAD_MULTIPLIER=1

# Dataset
IMAGENET1K_ROOT="/work/nvme/bdjz/shared/image_datasets/imagenet1k"
IMG_SIZE=256
NUM_WORKERS=8

# VAE
VAE_PATH="pretrained_models/vae/kl16.ckpt"

# Logging / Checkpoint
WANDB_ENTITY="ebwm_nlp"
WANDB_PROJECT="energy_diffusion_final"

# Preview
PREVIEW="--preview"
PREVIEW_INTERVAL=20
PREVIEW_LABELS="0,1,2,3,430,485,605,726,850"

# Evaluation (positional args passed from bash runner)
RESUME=$1
USE_ENERGY_FLAG=""
EVAL_BSZ=512
NUM_IMAGES=50000
EVAL_DTYPE=fp32

# Classifier-free guidance
CFG=${2:-0.0}

# REPA cache
CACHE_SHARD_SIZE=2000

# ------------------ Build ARGS ------------------
ARGS=""
ARGS+=" --seed ${SEED}"

ARGS+=" --model_type ${MODEL_TYPE}"
ARGS+=" --model_size ${MODEL_SIZE}"
ARGS+=" --patch_size ${PATCH_SIZE}"

ARGS+=" --epochs ${EPOCHS}"
ARGS+=" --warmup_epochs ${WARMUP_EPOCHS}"
ARGS+=" --batch_size ${BATCH_SIZE_PER_DEVICE}"
ARGS+=" --lr ${LR}"
ARGS+=" --grad_accu ${GRAD_ACCU}"
ARGS+=" --weight_decay ${WEIGHT_DECAY}"

ARGS+=" --diffusion_timesteps ${DIFFUSION_TIMESTEPS}"
ARGS+=" --beta_schedule ${BETA_SCHEDULE}"

ARGS+=" --mcmc_step_size ${MCMC_STEP_SIZE}"
ARGS+=" --energy_grad_multiplier ${ENERGY_GRAD_MULTIPLIER}"

ARGS+=" --data_path ${IMAGENET1K_ROOT}"
ARGS+=" --img_size ${IMG_SIZE}"
ARGS+=" --vae_path ${VAE_PATH}"
ARGS+=" --num_workers ${NUM_WORKERS}"

ARGS+=" --wandb_entity ${WANDB_ENTITY}"
ARGS+=" --wandb_project ${WANDB_PROJECT}"

ARGS+=" ${PREVIEW}"
ARGS+=" --preview_interval ${PREVIEW_INTERVAL}"
ARGS+=" --preview_labels ${PREVIEW_LABELS}"

ARGS+=" --resume ${RESUME}"
ARGS+=" ${USE_ENERGY_FLAG}"
ARGS+=" --eval_bsz ${EVAL_BSZ}"
ARGS+=" --eval_dtype ${EVAL_DTYPE}"
ARGS+=" --num_images ${NUM_IMAGES}"
ARGS+=" --num_sampling_steps ${NUM_SAMPLING_STEPS}"
ARGS+=" --val_data_path $IMAGENET1K_ROOT/validation"

ARGS+=" --cfg ${CFG}"

ARGS+=" --cache_shard_size ${CACHE_SHARD_SIZE}"